# Server Configuration
PORT=3001

# PostgreSQL Connection Strings
DEV_DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/dev_db
LOCAL_DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/local_db

# GitHub Integration (for Phase 2)
GITHUB_TOKEN=ghp_your_token_here
